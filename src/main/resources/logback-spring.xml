<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ===== APPENDERS ===== -->

    <!-- 1. Console : DEBUG et au-dessus, tous les packages -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. err.log : uniquement ERROR, packages ch.* -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>err.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>err.%d{yyyy-MM-dd}.log</fileNamePattern>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] ERROR %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        3. cafheg_{date-jour}.log : INFO et au-dessus, packages de services.
           Pas de tag <file> : le TimeBasedRollingPolicy gère lui-même le nom
           du fichier courant via fileNamePattern, ce qui garantit un nouveau
           fichier à chaque minuit.
    -->
    <appender name="FILE_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>cafheg_%d{yyyy-MM-dd}.log</fileNamePattern>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ===== LOGGERS ===== -->

    <!-- ERROR dans les packages ch.* → err.log (en plus du root) -->
    <logger name="ch" level="DEBUG" additivity="true">
        <appender-ref ref="FILE_ERROR"/>
    </logger>

    <!-- INFO dans les packages de services → cafheg_{date}.log (en plus du root) -->
    <logger name="ch.hearc.cafheg.domain" level="DEBUG" additivity="true">
        <appender-ref ref="FILE_INFO"/>
    </logger>

    <!-- Root : DEBUG → console -->
    <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
